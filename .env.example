# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/twitter_clone"

# Use a long, random value and keep it stable between restarts
JWT_SECRET="replace-with-a-long-random-secret"

# Keep development mode for local HTTP cookies
NODE_ENV="development"
PORT=5000
CLIENT_URL="http://localhost:3000"

# Optional host port used by Docker Compose
DOCKER_PORT=8080

# Required for post, avatar, and cover image uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend HTTPS API credentials used for password reset emails
RESEND_API_KEY="re_your-resend-api-key"
# Use onboarding@resend.dev only for testing with your Resend account email.
# Use an address on a verified domain when sending to other users.
EMAIL_FROM="X Clone <onboarding@resend.dev>"
EMAIL_FROM_NAME="X Clone"
